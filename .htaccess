# LBar Ivano-Frankivsk — тестовий сайт https://lbar-frankovsk.touchit.vinnica.ua/
# Мови: українська (контекст ua) — у корені сайту, російська (контекст web) — у /ru/
RewriteEngine On
RewriteBase /

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*/)?index\.php
RewriteRule ^index\.php$ / [L,R=301]

RewriteCond %{REQUEST_URI} ^index\.php$
RewriteCond %{QUERY_STRING} ^(.*)&?id=1&?(.*)$ [NC]
RewriteRule ^index\.php$ /?%1%2 [L,R=301]

# службові GET-параметри з реклами -> 301 на чисту адресу (як на сайті Дніпра)
RewriteCond %{QUERY_STRING} ^(myfield_sity1_tid|utm_source|ref|page|utm_medium)=(.*)$
RewriteRule ^(.*)$ /$1? [R=301,L]

# стара схема мов: /ua/... -> /... (українська тепер основна)
RewriteRule ^ua(?:/(.*))?$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ru/favicon.ico$ favicon.ico [L,QSA]

# відносні шляхи з <base href=".../ru/"> -> спільні папки
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ru/(assets|images|webp)/(.*)$ $1/$2 [L,QSA]

# російська версія
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(ru)(?:/(.*))?$ index.php?cultureKey=$1&q=$2 [L,QSA]

# українська (основна) версія
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]

# сжатие text, html, javascript, css, xml:
<ifModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/xhtml+xml text/css text/javascript application/javascript application/x-javascript image/svg+xml
</ifModule>

# кеш браузера
<ifModule mod_expires.c>
ExpiresActive On
 
#по умолчанию кеш в 5 секунд
ExpiresDefault "access plus 1 days"
 
# Включаем кэширование изображений и флэш на месяц
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType image/jpeg "access plus 4 weeks"
ExpiresByType image/webp "access plus 4 weeks"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/gif "access plus 43829 minutes"
ExpiresByType application/x-shockwave-flash "access plus 2592000 seconds"
 
# Включаем кэширование css, javascript и текстовых файлов на одну неделю
ExpiresByType text/css "access plus 604800 seconds"
ExpiresByType text/javascript "access plus 604800 seconds"
ExpiresByType application/javascript "access plus 604800 seconds"
ExpiresByType application/x-javascript "access plus 604800 seconds"
 
# Включаем кэширование html и htm файлов на один день
ExpiresByType text/html "access plus 43200 seconds"
 
# Включаем кэширование xml файлов на десять минут
ExpiresByType application/xhtml+xml "access plus 600 seconds"
 
# Нестандартные шрифты сайта 
ExpiresByType application/x-font-ttf "access plus 1 month"
ExpiresByType font/opentype "access plus 1 month"
ExpiresByType application/x-font-woff "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
</ifModule>

